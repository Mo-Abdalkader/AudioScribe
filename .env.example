# ── Required ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
GROQ_API_KEYS=key1,key2,key3

# ── Optional ──────────────────────────────────────────────
# Cohere as fallback summarizer (Groq is primary)
COHERE_API_KEY=
# Webhook validation secret token (set to random string in production)
WEB_SECRET_KEY=change-me-to-random-string

# ── Limits ────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_AUDIO_DURATION_MINUTES=60
MAX_UPLOAD_SIZE_MB=50
FREE_MAX_URL_SIZE_MB=200
PREMIUM_MAX_URL_SIZE_MB=2000
FREE_DAILY_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=3600

# ── Audio processing ──────────────────────────────────────
CHUNK_DURATION_MS=25000
CHUNK_OVERLAP_MS=3000
DEDUP_WINDOW_WORDS=20

# ── Summarization ─────────────────────────────────────────
SUMMARY_CHUNK_WORDS=3500
SUMMARY_CHUNK_OVERLAP=500
SUMMARY_CHUNK_MAX_TOKENS=1024
SUMMARY_FINAL_MAX_TOKENS=2048
SUMMARY_TEMPERATURE=0.7

# ── LLM Retry ─────────────────────────────────────────────
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_DELAY=2.0

# ── Output ────────────────────────────────────────────────
OUTPUT_TEMP_DIR=/tmp/audioscribe

# ── Server ────────────────────────────────────────────────
# Railway automatically sets PORT — do not override locally
# PORT=8000
# Your Railway public domain (set automatically on Railway)
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# Or your custom domain
# PUBLIC_DOMAIN=
# Set to 1 to disable Telegram bot entirely
# WEB_ONLY=0
